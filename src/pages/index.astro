---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle';
import PrPicker from '../components/PrPicker';
import Footer from '../components/Footer';
import { fetchViewer } from '../lib/github';
import { clearToken } from '../lib/auth';

const oauthConfigured = Boolean(env.GITHUB_CLIENT_ID && env.GITHUB_CLIENT_SECRET);
const error = Astro.url.searchParams.get('error');
const next = Astro.url.searchParams.get('next') ?? '/';

let viewer: Awaited<ReturnType<typeof fetchViewer>> | null = null;
if (Astro.locals.token) {
  try {
    viewer = await fetchViewer(Astro.locals.token);
  } catch {
    clearToken(Astro.cookies);
  }
}
---

<Layout title="PR Comment Inbox">
  <main class="mx-auto flex min-h-full max-w-lg flex-col justify-center px-4 py-12">
    <div class="mb-8 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 text-lg font-semibold">
        <svg viewBox="0 0 16 16" width="24" height="24" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
          ></path>
        </svg>
        PR Comment Inbox
      </a>
      <ThemeToggle client:load />
    </div>

    {error && (
      <div class="mb-6 rounded-md border border-danger/40 bg-danger-bg px-3 py-2 text-sm text-danger">{error}</div>
    )}

    {viewer ? (
      <section class="rounded-lg border border-border bg-canvas-subtle p-6">
        <div class="mb-5 flex items-center gap-3">
          <img src={viewer.avatarUrl} alt="" class="h-10 w-10 rounded-full" />
          <div>
            <div class="text-sm text-fg-muted">Signed in as</div>
            <div class="font-semibold">@{viewer.login}</div>
          </div>
          <form method="post" action="/api/auth/logout" class="ml-auto">
            <button class="btn btn-sm" type="submit">Sign out</button>
          </form>
        </div>
        <PrPicker client:load />
      </section>
    ) : (
      <section class="rounded-lg border border-border bg-canvas-subtle p-6">
        <h1 class="mb-1 text-xl font-semibold">Sign in to GitHub</h1>
        <p class="mb-5 text-sm text-fg-muted">
          A comment-centric inbox for pull request review threads. Your token is stored in an HTTP-only cookie and
          only ever sent to api.github.com.
        </p>

        {oauthConfigured && (
          <a href="/api/auth/login" class="btn btn-primary w-full justify-center py-2 text-base">
            Sign in with GitHub
          </a>
        )}

        <details class="mt-4" open={!oauthConfigured}>
          <summary class="cursor-pointer text-sm font-medium text-fg-muted">
            {oauthConfigured ? 'Or use a personal access token' : 'Use a personal access token'}
          </summary>
          <form method="post" action="/api/auth/token" class="mt-3 flex flex-col gap-3">
            <input type="hidden" name="next" value={next} />
            <label class="flex flex-col gap-1 text-sm">
              <span class="font-medium">Personal access token</span>
              <input
                name="token"
                type="password"
                required
                autocomplete="off"
                placeholder="ghp_… or github_pat_…"
                class="rounded-md border border-border bg-canvas px-3 py-2 font-mono text-sm outline-none focus:border-accent focus:ring-2 focus:ring-accent/30"
              />
              <span class="text-xs text-fg-muted">
                Needs the <code>repo</code> scope (classic) or Pull requests: read &amp; write (fine-grained).
              </span>
            </label>
            <button class="btn btn-primary justify-center" type="submit">Continue</button>
          </form>
        </details>
      </section>
    )}

    <p class="mt-6 text-center text-xs text-fg-muted">
      No token handy? <a href="/demo/demo/pull/1" class="text-accent hover:underline">Try the demo pull request</a>.
    </p>

    <Footer class="mt-10" />
  </main>
</Layout>
